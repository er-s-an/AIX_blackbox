{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "afr-snapshot/1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_commitment": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_key_id": {
      "type": "string"
    },
    "disclosure_set_id": {
      "const": "full"
    },
    "scope": {
      "const": "collected_evidence_only"
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "required": [
    "format_version",
    "snapshot_id",
    "run_id",
    "version",
    "previous_commitment",
    "created_at",
    "signer_key_id",
    "disclosure_set_id",
    "scope",
    "files"
  ]
}
